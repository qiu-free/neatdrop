# Copy to .env. Never commit .env or paste keys into chat.
# Leave blank to use local rules/manual organization without cloud calls.
NEATDROP_API_KEY=
NEATDROP_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NEATDROP_TEXT_MODEL=qwen-plus
NEATDROP_VISION_MODEL=qwen-vl-plus
# Hard request-count budget, not a currency estimate. No automatic retries.
NEATDROP_MAX_MODEL_REQUESTS=20
# Experimental local semantic candidates. Default off: development evaluation
# has not demonstrated a quality gain over enhanced rules. Never enables cloud.
NEATDROP_SEMANTIC_CANDIDATES=0
