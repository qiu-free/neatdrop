{
  "name": "neatdrop-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/check-local-bundle.mjs",
    "build:experience": "tsc -b && vite build --config vite.experience.config.ts && node scripts/check-experience-bundle.mjs",
    "preview:experience": "vite preview --config vite.experience.config.ts",
    "test": "vitest"
  },
  "dependencies": {
    "cytoscape": "3.33.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
